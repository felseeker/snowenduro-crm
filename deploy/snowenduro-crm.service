[Unit]
Description=SnowEnduro CRM
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=snowenduro
Group=snowenduro
WorkingDirectory=/opt/snowenduro-crm
EnvironmentFile=/etc/snowenduro-crm.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4173
Environment=CRM_DATA_DIR=/var/lib/snowenduro-crm
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=3
StateDirectory=snowenduro-crm
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/snowenduro-crm
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
