# The app listens only on this computer by default.
HOST=127.0.0.1
PORT=4173
# Optional absolute path for the SQLite database and uploaded photos.
# CRM_DATA_DIR=C:/snowenduro-crm-data

# Optional Telegram bot notifications. Keep real values in local .env only.
# TELEGRAM_BOT_TOKEN=

# Exact public website origin allowed to submit enquiries cross-origin.
# WEBSITE_ORIGIN=https://snowenduro.ru
# TRUST_PROXY=1 is only for a reverse proxy that sets X-Forwarded-For.

# Optional catalog publishing to the existing SnowEnduro site repository.
# Keep both tokens only in the server's private environment file.
# GITHUB_TOKEN=
# GITHUB_SITE_REPOSITORY=felseeker/snowenduro-site
# SYNC_CALLBACK_TOKEN=

# Required only when the CRM is intentionally exposed remotely before first setup.
# SETUP_TOKEN=
