# Public browser configuration. The publishable key is intended to be exposed to the browser.
VITE_SUPABASE_URL=
VITE_SB_PUBLISHABLE_KEY=

# Server-only values. Never add real values to Git or Vite-prefixed variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Public intake stays closed until the privacy policy and Russian hosting are ready.
PUBLIC_LEAD_INTAKE_ENABLED=false
PRIVACY_POLICY_VERSION=
LEAD_RATE_LIMIT_HMAC_SECRET=
PUBLIC_SITE_ORIGINS=https://snowenduro.ru,https://www.snowenduro.ru

# Server secrets used by the CRM Edge Functions.
TELEGRAM_BOT_TOKEN=
SITE_GITHUB_TOKEN=
SITE_GITHUB_OWNER=felseeker
SITE_GITHUB_REPO=snowenduro-site
SITE_GITHUB_WORKFLOW=catalog-sync.yml
SITE_GITHUB_BRANCH=main
SITE_CATALOG_SYNC_SECRET=
CRM_PUBLIC_URL=https://felseeker.github.io/snowenduro-crm
CRM_ORIGINS=https://felseeker.github.io,http://localhost:5173
